{
  "permission": {
    "bash": "ask",
    "read": "allow",
    "edit": "allow",
    "glob": "allow",
    "grep": "allow",
    "execute_git status": "allow",
    "execute_git diff": "allow",
    "execute_./gradlew assembleDebug": "ask",
    "execute_git push": "deny",
    "execute_rm -rf*": "deny",
    "execute_sudo*": "deny"
  },
  "editMode": "diff",
  "autoCompactAfterTurns": 18,
  "maxOpenFilesContext": 3,
  "provider": {
    "openrouter": {
      "options": {
        "provider": {
          "sort": "price",
          "data_collection": "deny",
          "zdr": true
        }
      }
    }
  }
}